# --- vLLM / DotsOCR backend ---------------------------------------------
DOTS_OCR_HOST=dots-ocr
DOTS_OCR_PORT=8000
# Set to use a remote OpenAI-compatible endpoint (e.g. RunPod serverless:
# https://api.runpod.ai/v2/<ENDPOINT_ID>/openai/v1). Overrides HOST/PORT.
DOTS_OCR_BASE_URL=
DOTS_OCR_API_KEY=0
DOTS_OCR_MODEL=model
PROMPT_MODE=prompt_ocr
OCR_MODE=DOTS
ROOT_PATH=

# Values below are matched to the main client (120s HTTP timeout, 20-page cap).
# Change both sides together.

# --- Inference tuning ---------------------------------------------------
INFERENCE_TIMEOUT_SECONDS=60
INFERENCE_MAX_RETRIES=1
# Whole request (queue + all pages); keep below the client's 120s HTTP timeout.
REQUEST_DEADLINE_SECONDS=110
MAX_COMPLETION_TOKENS=16384
PDF_DPI=200
PAGE_CONCURRENCY=8

# --- Limits / admission control ----------------------------------------
MAX_CONCURRENT_REQUESTS=4
QUEUE_TIMEOUT_SECONDS=20
# Largest upload clients send for OCR is 40 MB.
MAX_UPLOAD_MB=50
# Matches the client-side page cap.
MAX_PAGES=20
LIBREOFFICE_TIMEOUT_SECONDS=120

# --- Security -----------------------------------------------------------
# Non-empty => /parse-file requires header "X-API-Key: <value>".
# Leave empty unless every client sends this header.
SERVICE_API_KEY=

LOG_LEVEL=INFO
